# Session Scribe - Environment Variables Template
# Copy this file to .env and insert your personal API keys and tokens.
# Security Rule: Never commit .env to version control or publish keys.

# Optional: NVIDIA Hosted Riva Cloud Speech API Key
# Enables Cloud Parakeet and Cloud Whisper models via NVIDIA NGC.
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# Optional: Hugging Face User Access Token
# Required for PyAnnote speaker diarization and voice enrollment models.
# Must have accepted user agreements on huggingface.co for pyannote/speaker-diarization-3.1
HF_TOKEN=hf_your_huggingface_token_here

# Optional: Voice Vault Auto-Lock Duration (Minutes)
# Default is 30 minutes of inactivity. Set to 0 to disable auto-lock during session.
AUTO_LOCK_MINUTES=30


